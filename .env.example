# Firebase Authentication (ล็อกอิน Google จริง)
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Firebase Console
# (Project settings → General → Your apps → SDK setup and configuration)
# บน Vercel ให้ใส่ค่าเหล่านี้ใน Project → Settings → Environment Variables
#
# ถ้าไม่ตั้งค่า แอปจะถอยไปใช้ล็อกอินชั่วคราว (พิมพ์อีเมล) โดยอัตโนมัติ

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ไม่บังคับ
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# อีเมลผู้ดูแลตั้งต้น (Admin) คั่นด้วยจุลภาค — ย้ายสถานีแค่เปลี่ยนค่านี้ ไม่ต้องแก้โค้ด
# เช่น VITE_BOOTSTRAP_ADMINS="chief@example.com, deputy@example.com"
VITE_BOOTSTRAP_ADMINS=
